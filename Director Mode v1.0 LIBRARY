 // Builds the hidden Director Mode instructions that are sent
 // to the AI before every response.
 // Empty sections are automatically omitted to save context.
 //
 // Most users SHOULD NOT MODIFY this section.

 function buildDirectorContext() {
    if (!directorEnabled())
        return "";
    const out = [];

    out.push("=================================");
    out.push("DIRECTOR MODE");
    out.push("=================================");
    out.push("");

    out.push("The following information is");
    out.push("hidden Director guidance.");
    out.push("");

    out.push("It is NEVER:");
    out.push("- Player dialogue");
    out.push("- Player actions");
    out.push("- NPC dialogue");
    out.push("- Story narration");
    out.push("");

    out.push("Use these instructions when");
    out.push("generating the next response.");
    out.push("");

    // AI DIRECTIVES
    // ------------------------------------------------
    if (state.director.ai.length) {
        out.push("AI DIRECTIVES");
        state.director.ai.forEach(item => {
            out.push("- " + item);
        });
        out.push("");
    }

    // WRITING TONE
    // ------------------------------------------------
    if (state.director.tone.length) {
        out.push("WRITING TONE");
        state.director.tone.forEach(item => {
            out.push("- " + item);
        });
        out.push("");
    }

    // SCENE MOOD
    // ------------------------------------------------
    if (state.director.mood) {
        out.push("CURRENT MOOD");
        out.push("- " + state.director.mood);
        out.push("");
    }

    // GENRES
    // ------------------------------------------------
    if (state.director.genres.length) {
        out.push("GENRES");
        state.director.genres.forEach(item => {
            out.push("- " + item);
        });
        out.push("");
    }

    // CURRENT FOCUS
    // ------------------------------------------------
    if (state.director.focus) {
        out.push("CURRENT FOCUS");
        out.push("- " + state.director.focus);
        out.push("");
    }

    // SCENE
    // ------------------------------------------------
    if (state.director.scene.length) {
        out.push("CURRENT SCENE");
        state.director.scene.forEach(item => {
            out.push("- " + item);
        });
        out.push("");
    }

    // PLOT
