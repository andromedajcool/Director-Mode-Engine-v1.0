// ============================================================
// Director Engine v1.0
// Context Tab
// ============================================================
//
// OPTIONAL
// (RECOMMENDED)
// Set to true to ALWAYS include the No Mind Reading / Dialogue
// Rules, even when Director Mode is OFF. 
//
// Set to false to use ONLY the rules provided by Director Mode.
//
const ALWAYS_USE_DIALOGUE_RULES = true;

// ============================================================

const modifier = (text) => {

    let finalText = "";

    // Optional Dialogue Rules
    if (ALWAYS_USE_DIALOGUE_RULES) {

        finalText += `
DIALOGUE RULES

• Anything inside quotation marks ("") is spoken aloud.
• Only words inside quotation marks are heard by other characters.
• Anything outside quotation marks is narration, description, or internal thoughts.
• Thoughts are never spoken aloud.
• Internal monologue is private.
• NPCs cannot hear or react to thoughts.
• NPCs cannot know information that has not been spoken aloud or directly observed.
• NPCs may only respond to:
  - Spoken dialogue inside quotation marks.
  - Visible actions.
  - Information they already logically know.
• Never have characters answer or react to unspoken thoughts.
• Never treat narration as spoken dialogue.

`;
    }

    // Director Engine
    if (typeof initDirector === "function") {

        initDirector();

        if (directorEnabled()) {

            const directorText = buildDirectorContext();

            if (directorText) {

                if (finalText.length) {
                    finalText += "\n";
                }

                finalText += directorText;
            }
        }
    }

    if (finalText.length) {
        finalText += "\n\n";
    }

    finalText += text;

    return {
        text: finalText
    };

};

// Don't modify this part
modifier(text);
