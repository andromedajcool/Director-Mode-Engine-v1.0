 // GENERIC HELPER FUNCTIONS
 // ============================================================
 // ENGINE CODE
 // These functions are used internally by Director Mode.

 // Removes leading/trailing whitespace.
 function normalize(text) {
    if (text === undefined || text === null)
        return "";
    return String(text).trim();
 }

 // True if the value is empty after trimming.
 function isBlank(text) {
    return normalize(text).length === 0;
 }

 // Adds an item to an array while preventing duplicates
 // and enforcing a maximum size.
 function pushLimited(array, value, max) {
    value = normalize(value);
    if (isBlank(value))
        return false;
    if (array.includes(value))
        return false;
    array.push(value);
    while (array.length > max)
        array.shift();
    return true;
 }

 // Removes a matching item from an array.
 function removeItem(array, value) {
    value = normalize(value);
    const index = array.indexOf(value);
    if (index >= 0) {
        array.splice(index, 1);
        return true;}
    return false;
 }

 // Clears every element from an array.
 function clearArray(array) {
    array.length = 0;
 }

 // Clears every property from an object.
 function clearObject(obj) {
    Object.keys(obj).forEach(key => {
        delete obj[key];
    });
 }

 // Creates an object property if it doesn't exist.
 function ensureObjectArray(object, key) {
    key = normalize(key);
    if (!object[key])
        object[key] = [];
    return object[key];
 }

 // Stores data grouped by name.
 function addNamedEntry(object, name, value, max) {
    name = normalize(name);
    value = normalize(value);
    if (isBlank(name) || isBlank(value))
        return false;
    const list = ensureObjectArray(object, name);
    return pushLimited(list, value, max);
 }

 // Returns every key in alphabetical order.
 function getSortedKeys(object) {
    return Object.keys(object).sort();
 }

 // Determines whether a line is a Director command.
 function isCommand(line) {
    return normalize(line).startsWith("*");
 }

 // Returns true if Director Mode is enabled.
 function directorEnabled() {
    return state.director.enabled;
 }

 // Enables Director Mode.
 function directorOn() {
    state.director.enabled = true;
 }

 // Disables Director Mode.
 function directorOff() {
    state.director.enabled = false;
 }

 // Optional debug logging.
 function directorLog(message) {
    if (!DIRECTOR.DEBUG)
        return;
    console.log("[DIRECTOR] " + message);
 }

